# Only what the Dockerfile copies is needed: keep secrets, data, caches and tooling out of the build context.
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.claude/
.git/
.github/
tests/
tools/
data/
deploy/.env
deploy/certs/
frontend/node_modules/
ui/app/
*.md
!postman/README.md
