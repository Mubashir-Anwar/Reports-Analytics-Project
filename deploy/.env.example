# Copy to deploy/.env and fill in. Never commit the real file.
# Long random values: python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_DB_PASSWORD=
REPORTING_ADMIN_TOKEN=
REPORTING_SESSION_SECRET=
REPORTING_ACCESS_SECRET=
REPORTING_TIMEZONE=Asia/Karachi

# The "default" MongoDB data adapter (optional; adapters can also be added in the designer)
MONGODB_URI=
MONGODB_DATABASE=

# E-mail for scheduled reports (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
