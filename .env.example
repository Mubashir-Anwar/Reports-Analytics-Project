# Local MongoDB connection. Credentials hon to URI mein apne local credentials dein.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=Cascade-Local

# Local use: khali chhor dein; app token khud generate karke data/private_secrets.json mein rakhegi.
# Public deployment: platform ke private environment settings mein alag strong token dein.
REPORTING_ADMIN_TOKEN=

# Saved report JSON aur named connection profiles ki jagah.
# Grizzly par is path ko persistent writable volume se map karein.
REPORTING_DATA_DIR=./data
# Python-based static reports ko load karne ke liye optional switch.
REPORTING_LOAD_BUILTIN_REPORTS=false

# Main aggregation collection reports/sbp_pipeline.json ke runCommand.aggregate mein hai.
# $lookup collections MONGODB_DATABASE ke andar honi chahiye.

# Execution audit is saved locally under REPORTING_DATA_DIR/audit.
# MongoDB audit inserts are optional and disabled by default; read-only users work.
AUDIT_DATABASE=Cascade-Local
AUDIT_COLLECTION=report_execution_audit
AUDIT_TO_MONGODB=false
# true => audit record local file mein save na ho to report release nahi hoti (fail-closed)
AUDIT_REQUIRED=false

# Query limits
REPORT_MAX_TIME_MS=30000
REPORT_MAX_ROWS=10000
REPORT_ALLOW_DISK_USE=false
LOG_LEVEL=INFO

# Optional: Unicode/Urdu PDF ke liye .ttf font ka path (designer PDF mein istemal hota hai)
REPORT_PDF_FONT_PATH=
