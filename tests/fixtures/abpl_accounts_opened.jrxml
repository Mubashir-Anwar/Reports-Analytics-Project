		<queryString language="MongoDbQuery">
			<![CDATA[{
  "runCommand": {
    "aggregate": "Edith-DOABPL-Workflows",
    "pipeline":	[
        {
            "$match" : {
                "Status" : NumberInt(1)
            }
        },
        {
            "$addFields" : {
                "CreationDateTime" : {
                    "$toDate" : "$CreationDateTime"
                },
                "LastUpdateDateTime" : {
                    "$toDate" : "$LastUpdateDateTime"
                },
                "AccountTypeCode" : {
                    "$arrayElemAt" : [
                        "$GridFields.ABPL37.ABPL40",
                        0.0
                    ]
                },
                "BranchCode" : {
                    "$arrayElemAt" : [
                        "$GridFields.ABPL37.ABPL26",
                        0.0
                    ]
                },
                "RegionCode" : {
                    "$arrayElemAt" : [
                        "$GridFields.ABPL37.ABPL110",
                        0.0
                    ]
                },
            }
        }, 
	{
		"$match" : {
			"$and" : [
				{'LastUpdateDateTime' : { '$gte' : $P{AdjustedStartDate},  '$lte' :$P{AdjustedEndDate}}},      
				{'BranchCode' : $P!{Branch_1}},
				{'RegionCode' : $P!{Region_1}},
				{'AccountTypeCode' : $P!{AccountType_1}},
			]
		}
	},
        {
            "$lookup" : {
                "from" : "Quantum-ABPL1S",
                "localField" : "GridFields.ABPL37.ABPL26",
                "foreignField" : "Code",
                "as" : "Branch"
            }
        }, 
        {
            "$set" : {
                "Date" : "$LastUpdateDateTime",
                "Week" : {
                    "$week" : "$LastUpdateDateTime"
                },
                "Month" : {
                    "$arrayElemAt" : [
                        [
                            "",
                            "January",
                            "February",
                            "March",
                            "April",
                            "May",
                            "June",
                            "July",
                            "August",
                            "September",
                            "October",
                            "November",
                            "December"
                        ],
                        {
                            "$month" : "$LastUpdateDateTime"
                        }
                    ]
                },
                "Quarter" : {
                    "$concat" : [
                        "Q",
                        {
                            "$toString" : {
                                "$ceil" : {
                                    "$divide" : [
                                        {
                                            "$month" : "$LastUpdateDateTime"
                                        },
                                        3.0
                                    ]
                                }
                            }
                        }
                    ]
                },
                "Year" : {
                    "$year" : "$LastUpdateDateTime"
                }
            }
        }, 
        {
            "$lookup" : {
                "from" : "Quantum-ABPL40S",
                "localField" : "GridFields.ABPL37.ABPL40",
                "foreignField" : "Code",
                "as" : "AccountType"
            }
        }, 
        {
            "$project" : {
                "AccountType" : {
                    "$arrayElemAt" : [
                        "$AccountType.Name",
                        0.0
                    ]
                },
                "Branch" : {
                    "$arrayElemAt" : [
                        "$Branch.Name",
                        0.0
                    ]
                },
                "Region" : {
                    "$arrayElemAt" : [
                        "$GridFields.ABPL37.ABPL110",
                        0.0
                    ]
                },
                "LastUpdateDateTime" : 1.0,
                "CreationDateTime" : 1.0,
                "Date" : 1.0,
                "Week" : 1.0,
                "Month" : 1.0,
                "Quarter" : 1.0,
                "Year" : 1.0
            }
        },
        {
            "$group" : {
                "_id" : {
                    "Branch" : "$Branch",
                    "Region" : "$Region",
                    "AccountType" : "$AccountType",
                    "Week" : "$Week",
                    "Month" : "$Month",
                    "Quarter" : "$Quarter",
                    "Year" : "$Year",
                },
                "count" : {
                    "$sum" : 1.0
                },
                "LastUpdateDateTime" : {
                    "$max" : "$LastUpdateDateTime"
                }
            }
        },
        {
            "$project" : {
                "_id" : 0.0,
                "Branch" : "$_id.Branch",
                "Region" : "$_id.Region",
                "AccountType" : "$_id.AccountType",
                "Month" : "$_id.Month",
                "Week" : "$_id.Week",
                "Quarter" : "$_id.Quarter",
                "Year" : "$_id.Year",
                "count" : {
                    "$toInt" : "$count"
                },
                "LastUpdateDateTime" : 1.0
            }
        },
{
  "$sort": {
    "count": -1.0,
    "Date": -1.0
  }
}
    ]
  }
}]]>
		</queryString>
